#!/usr/bin/env bash
# Claude Code hook -> godel.  Usage (in hook settings): godel-hook EVENT
# Reads the hook JSON on stdin and hands it to Emacs, base64-encoded so no
# quoting is needed.  GODEL_SERVER is the Emacs server socket, set by godel
# when it launches the session.  Always exits 0 so a missing Emacs never
# disturbs Claude.
event=$1
[ -n "$GODEL_SERVER" ] || exit 0
# The PIDs above this hook, parent first.  godel only takes events from
# sessions under its Emacs (`godel-status-from-this-emacs-p'); sessions in
# Claude's background daemon have these hooks too, and nothing in their
# environment says so (CLAUDE_CODE_SESSION_KIND is not passed to hooks).  Read
# now, while every process in the chain is alive: by the time Emacs handles a
# SessionEnd, the session may be gone.  Empty where there is no /proc.
ancestors=
pid=$PPID
n=0
while [ "$pid" -gt 1 ] 2>/dev/null && [ "$n" -lt 64 ]; do
  ancestors="$ancestors $pid"
  read -r stat 2>/dev/null < "/proc/$pid/stat" || break
  # Fields after the command name, which ends at the last ")": state, ppid, ...
  set -- ${stat##*)}
  pid=$2
  n=$((n + 1))
done
payload=$(base64 -w0)
emacsclient -s "$GODEL_SERVER" -n \
  --eval "(godel-status-event \"$event\" \"$payload\" \"${ancestors# }\")" >/dev/null 2>&1
exit 0
