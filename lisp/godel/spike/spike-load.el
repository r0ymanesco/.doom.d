;;; spike-load.el --- terminal load measurements -*- lexical-binding: t -*-
(require 'ghostel)
(defun godel-spike-load-start (n)
  (dotimes (i n)
    (let ((buf (get-buffer-create (format "*godel-load-%d*" i))))
      (with-current-buffer buf
        (ghostel-exec buf "python3" (list "-I" "/home/tzeyang/.paradev/worktrees/doom/design-mode-emacs-turns-797c93aa/lisp/godel/spike/tui-load.py"))))))
(defun godel-spike-load-stop ()
  (dolist (b (buffer-list))
    (when (string-prefix-p "*godel-load-" (buffer-name b))
      (let ((kill-buffer-query-functions nil))
        (when (get-buffer-process b) (delete-process (get-buffer-process b)))
        (kill-buffer b)))))
(defvar godel-spike-lag nil)
(defun godel-spike-measure-lag (secs)
  "Every 50ms timer for SECS; record max/avg lateness in ms."
  (setq godel-spike-lag nil)
  (let* ((interval 0.05) (expected (+ (float-time) interval)) (stop (+ (float-time) secs)) timer)
    (setq timer (run-with-timer interval interval
                  (lambda ()
                    (let ((now (float-time)))
                      (push (* 1000 (max 0 (- now expected))) godel-spike-lag)
                      (setq expected (+ now interval))
                      (when (> now stop) (cancel-timer timer))))))
    t))
(defun godel-spike-lag-summary ()
  (list :n (length godel-spike-lag)
        :max-ms (round (apply #'max godel-spike-lag))
        :avg-ms (/ (round (* 10 (/ (apply #'+ godel-spike-lag) (length godel-spike-lag)))) 10.0)))
